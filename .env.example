# mkt-alerts — delivery credentials for the check.ts alert checker.
# Copy to `.env` (gitignored) and fill in real values. Source before running:
#   set -a; source .env; set +a; bun scripts/check.ts
# Secrets live in Bitwarden ('dev' collection) under mkt-daemon/* — .env mirrors them.

# ── Email via Brevo (PRIMARY transport) ────────────────────────────────────────
# The `email:you@example.com` channel sends via Brevo's transactional email HTTP
# API (POST https://api.brevo.com/v3/smtp/email) — a plain POST, no verified
# domain needed (just a validated sender). This is the primary email path; when
# BREVO_API_KEY is set it is used over ntfy-email and Resend below.
# Free tier ~300 emails/day; Brevo free appends a "Sent with Brevo" footer.
# Store the key in Bitwarden as mkt-daemon/brevo-api-key.
BREVO_API_KEY=xkeysib-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# Sender address (must be a validated sender in your Brevo account). Falls back
# to ALERT_EMAIL when unset.
ALERT_EMAIL_FROM=alerts@agentlabs.cc

# ── ntfy (default push + native email FALLBACK) ────────────────────────────────
# Push channel for the phone app. Also an email FALLBACK: when BREVO_API_KEY is
# unset, the `email:` channel publishes here with an `Email:` header and ntfy
# delivers the alert as an email. Same topic powers phone push.
NTFY_TOPIC=mkt-xxxxxxxxxxxxxxxx
# Optional self-hosted server (default https://ntfy.sh)
# NTFY_SERVER=https://ntfy.sh
# REQUIRED for email: ntfy.sh blocks ANONYMOUS email sending — the Email header
# needs an access token from a (free) ntfy account. Push works without it.
# Free tier = 5 emails/day. Create at ntfy.sh → Account → Access tokens.
NTFY_TOKEN=tk_xxxxxxxxxxxxxxxxxxxxxxxxxx
# Optional: when set, the deployed dividend-watch push is ALSO emailed here.
ALERT_EMAIL=you@example.com

# ── Email via Resend (LAST-RESORT FALLBACK) ────────────────────────────────────
# Used by the `email:` channel *only when both BREVO_API_KEY and NTFY_TOPIC are
# unset*. Heavier path: needs a Resend account + API key + a verified sender
# domain. Prefer Brevo above.
# RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxx

# ── Telegram bot (Bot API) — for `--channel telegram-bot:@Channel` ─────────────
TELEGRAM_BOT_TOKEN=123456789:AAxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
